# Leave blank to run fully offline (template narration, no LLM calls).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Optional: if empty, Entra ID (DefaultAzureCredential) is used instead of a key.
AZURE_OPENAI_API_KEY=
# Optional: spoken full-time recap with Azure AI Speech (same Foundry / AI Services resource works).
# Set SPEECH_REGION plus SPEECH_KEY, or SPEECH_RESOURCE_ID to use Entra ID (Speech User role) instead of a key.
SPEECH_REGION=
SPEECH_KEY=
SPEECH_RESOURCE_ID=
# Optional: cap model calls per hour on a public deployment (over the cap the app uses grounded templates).
ITG_MAX_MODEL_CALLS_PER_HOUR=
